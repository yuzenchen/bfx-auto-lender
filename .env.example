# Bitfinex API Key（建議只開 Margin Funding read/write 權限，不要開提幣/交易）
BFX_API_KEY=your_api_key_here
BFX_API_SECRET=your_api_secret_here

# 伺服器設定（本機執行預設綁 127.0.0.1；Docker 內會自動用 0.0.0.0）
PORT=3000

# TOTP 一次性密碼驗證（雲端部署必填；留空 = 停用，僅限本機使用）
# 用 `npm run totp:setup` 產生，並加入 Google Authenticator 等 App
TOTP_SECRET=

# 雲端 HTTPS 網域（搭配 docker-compose.cloud.yml 的 Caddy 使用，例：bfx.yuzen.tw）
DOMAIN=
