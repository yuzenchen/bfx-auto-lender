{
  "name": "bfx-auto-lender",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:console": "tsx watch server/console.ts",
    "totp:setup": "tsx server/totp-setup.ts",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
